# Copy to .env and fill in. Never commit .env.
BOT_TOKEN=YOUR_BOT_TOKEN
LOG_LEVEL=INFO

# Optional local LLM (https://ollama.com). Leave OLLAMA_MODEL empty to disable.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT=120

# Restrict /ask to these Telegram user IDs (JSON list). Empty = anyone who finds the bot.
ASK_ALLOWED_USER_IDS=[]
ASK_MAX_PROMPT_CHARS=2000
ASK_MAX_CONCURRENT=2
